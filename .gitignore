# ============================================
# .gitignore —— 告诉 git 哪些文件不要上传
# 规则：每行一个模式；# 开头是注释；空行被忽略
# 详细语法见文末
# ============================================

# ---------- C / C++ 编译产物 ----------
# 可执行文件
*.exe
*.out
*.app

# 目标文件与库文件（编译中间产物）
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib

# 调试与编译临时文件
*.gch
*.pch
*.d
*.dSYM/
*.idb
*.pdb
*.ilk
*.exp

# 编译出的构建目录
build/
Build/
bin/
obj/
out/
cmake-build-*/

# CMake 自动生成的文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
!Makefile.am

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.vs/

# ---------- 操作系统垃圾文件 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# ---------- 敏感信息（切勿上传！）----------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/
credentials.json

# ---------- Python（以后学 Python 时可直接用）----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---------- Node.js / 前端（以后学 JS 时可直接用）----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
.next/
.nuxt/
coverage/
.eslintcache

# ---------- Java（本机已装 JDK，预留）----------
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.temp
*.bak
*.cache
tmp/
temp/

# ---------- 编译/运行产生的个人测试文件 ----------
# 你自己临时写着玩的代码，不想上传可以放这里
playground/
scratch/

# ============================================
# 语法速查
# ============================================
#  *.txt         匹配所有 .txt 结尾的文件
#  /build        只匹配根目录下的 build（子目录里的不管）
#  build/        匹配任何位置的 build 目录
#  !important.o  感叹号表示"不要忽略"，用来推翻前面的规则
#  **/temp       匹配任意层级下的 temp
#
# 重要提示：本文件只对"尚未被 git 追踪"的文件生效。
# 如果某个文件已经被 commit 过，之后写进这里也不会被忽略，
# 需要先执行：git rm --cached 文件名
# ============================================
